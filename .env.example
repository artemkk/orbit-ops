# Copy to .env and fill in. Never commit .env.

# --- Local stack defaults (used by docker-compose) ---
REDPANDA_BROKERS=localhost:19092
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=telemetry

# --- Sim configuration ---
SIM_MODE=fast               # fast | realtime
SIM_TICK_SECONDS=1.0        # sim-seconds per tick
SIM_SPEEDUP=60              # only used in fast mode (1 wall-sec = N sim-secs)
SIM_START_ISO=2026-05-24T00:00:00Z
SIM_DURATION_HOURS=24

# --- Deployed (filled in week 1, day 6) ---
